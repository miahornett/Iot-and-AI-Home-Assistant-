// 4. HELPER FUNCTIONS
void setup_wifi() {
  Serial.print("Connecting to WiFi...");
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi connected.");
}

void syncTime() {
  // Only sync if the RTC has lost track of time to save battery
  time_t now = time(nullptr);
  if (now < 1672531200) { 
    configTime(0, 0, "pool.ntp.org", "time.google.com");
    Serial.print("Syncing Clock for TLS (First boot only): ");
    while (now < 1672531200) { 
      delay(500);
      Serial.print(".");
      now = time(nullptr);
    }
    Serial.println("\n[OK] Time Synced.");
  }
}

void connect_mqtt() {
  Serial.print("Attempting STRICT mTLS connection...");
  if (client.connect(mqtt_client_id)) {
    Serial.println("CONNECTED SECURELY!");
  } else {
    Serial.print("failed, rc=");
    Serial.print(client.state());
    Serial.println(" - Retrying in 5s...");
    delay(5000);
  }
}


// 5. MAIN LOGIC (Runs once per wakeup)
void setup() {
  Serial.begin(115200);
  analogReadResolution(12);
  bootCount++;

  // 1. Take a rapid analog reading immediately upon waking up
  int rawValue = analogRead(pressurePin);
  int currentPressure = map(rawValue, 0, 4095, 0, 5000);
  
  Serial.print(">>> WOKE UP. Pressure Value: ");
  Serial.println(currentPressure);

  // 2. Core Battery Logic: Did the pressure change meaningfully?
  if (abs(currentPressure - lastPressure) >= threshold) {
    Serial.println("*** SIGNIFICANT PRESSURE CHANGE DETECTED! Booting Network Stack ***");
    
    // Boot the power-hungry Wi-Fi only because something changed
    setup_wifi();
    syncTime(); 

    espClient.setCACert(root_ca);          
    espClient.setCertificate(client_cert); 
    espClient.setPrivateKey(client_key);   
    espClient.setHandshakeTimeout(45); 

    client.setServer(mqtt_server, 8883);
    connect_mqtt();

    if (client.connected()) {
      String payload = String(currentPressure);
      
      if (client.publish(mqtt_publish_topic, payload.c_str())) {
        Serial.print("Secure Publish Successful: ");
        Serial.println(payload);
        
        // Update RTC memory for the next wakeup only on a successful publish
        lastPressure = currentPressure;
      } else {
        Serial.println("Secure Publish Failed!");
      }
      delay(500); // Allow packet to fully transmit before pulling the plug
    }
    
    // Clean disconnect
    client.disconnect();
    WiFi.disconnect(true);
    WiFi.mode(WIFI_OFF);
    
  } else {
    // If the pressure is essentially the same as 2 seconds ago, skip Wi-Fi entirely!
    Serial.println("No meaningful change in pressure. Bypassing Wi-Fi to save battery.");
  }

  // 6. PREPARE FOR DEEP SLEEP
  // Set the internal hardware timer to wake us up again in X seconds
  uint64_t sleepTime_us = WAKEUP_INTERVAL_SEC * 1000000ULL; 
  esp_sleep_enable_timer_wakeup(sleepTime_us);
  
  Serial.println("Going to Deep Sleep now... Zzz...");
  delay(100); 
  esp_deep_sleep_start();
}

// 7. LOOP (Obsolete in Deep Sleep Architecture)
void loop() {
  // Never reached. CPU shuts down at the end of setup().
}
