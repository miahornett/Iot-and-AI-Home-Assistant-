// ==========================================
// 4. HELPER FUNCTIONS
// ==========================================
void syncTime() {
    time_t now = time(nullptr);
    if (now < 1672531200) { 
        configTime(0, 0, "pool.ntp.org", "time.google.com");
        Serial.print("Syncing Clock for TLS... ");
        while (now < 1672531200) { 
            delay(500);
            Serial.print(".");
            now = time(nullptr);
        }
        Serial.println(" [OK]");
    }
}

void setup_wifi() {
    Serial.print("Connecting to WiFi...");
    WiFi.begin(ssid, password);
    
    int retry_count = 0;
    while (WiFi.status() != WL_CONNECTED && retry_count < 20) {
        delay(500);
        Serial.print(".");
        retry_count++;
    }
    
    if (WiFi.status() == WL_CONNECTED) {
       WiFi.setTxPower(WIFI_POWER_8_5dBm); 
       Serial.println(" [CONNECTED]");
    } else {
       Serial.println(" [FAILED]");
    }
}

void connect_mqtt() {
    Serial.print("Attempting STRICT mTLS connection...");
    if (client.connect(mqtt_client_id)) {
        Serial.println(" [CONNECTED SECURELY]");
    } else {
        Serial.print(" [FAILED, rc=");
        Serial.print(client.state());
        Serial.println("]");
    }
}

void sendHexData(String hexString) {
    int hexStringLength = hexString.length();
    if (hexStringLength % 2 != 0) return;
 
    int byteCount = hexStringLength / 2;
    byte hexBytes[byteCount];
    for (int i = 0; i < hexStringLength; i += 2) {
        String byteString = hexString.substring(i, i + 2);
        byte hexByte = (byte)strtoul(byteString.c_str(), NULL, 16);
        hexBytes[i / 2] = hexByte;
    }
    HMMDSerial.write(hexBytes, byteCount); 
}

// ==========================================
// 5. MAIN LOGIC (Runs once per wakeup)
// ==========================================
void setup() {
    // Keep your power-saving 80MHz CPU limit!
    setCpuFrequencyMhz(80); 

    Serial.begin(115200); 
    bootCount++;
    
    // 1. Initialize Sensor Serial and send the query Hex command
    HMMDSerial.begin(HMMD_BAUDRATE, SERIAL_8N1, RX1_PIN, TX1_PIN);
    sendHexData(hex_to_send);
    
    Serial.print(">>> WOKE UP. Listening to Radar for up to 3 seconds...");

    // 2. We must "listen" to the UART stream until we catch a valid Range reading.
    // We put a 3-second timeout on this so the ESP32 doesn't freeze forever if the sensor unplugs.
    float currentDistance = -1.0;
    bool validReadingFound = false;
    unsigned long listenStartTime = millis();
    
    while (millis() - listenStartTime < 3000) {
        if (HMMDSerial.available() > 0) {
            String line = HMMDSerial.readStringUntil('\n');
            line.trim();

            if (line.startsWith("Range ")) {
                String distanceStr = line.substring(6); 
                currentDistance = distanceStr.toFloat();
                validReadingFound = true;
                break; // We got our reading, break out of the loop immediately!
            }
        }
        delay(10); // Small delay to prevent watchdog crash
    }

    if (!validReadingFound) {
        Serial.println(" [TIMEOUT] No valid data received from HMMD sensor.");
    } else {
        Serial.print(" [SUCCESS] Range: ");
        Serial.print(currentDistance);
        Serial.println(" cm");

        // 3. Core Battery Logic: Did the distance change meaningfully?
        float diff = abs(currentDistance - lastPublishedDistance);

        if (diff >= CHANGE_THRESHOLD_CM) {
            Serial.print("*** SECURE CHANGE DETECTED (");
            Serial.print(diff);
            Serial.println("cm) Booting Network Stack ***");
            
            // Boot the power-hungry Wi-Fi
            setup_wifi();
            syncTime();

            espClient.setCACert(root_ca);
            espClient.setCertificate(client_cert);
            espClient.setPrivateKey(client_key);
            
            // Keep your 60s timeout due to the 80MHz CPU speed
            espClient.setHandshakeTimeout(60); 

            client.setServer(mqtt_server, 8883);
            connect_mqtt();

            if (client.connected()) {
                char payload[10];
                dtostrf(currentDistance, 5, 2, payload); 
                
                if (client.publish(mqtt_publish_topic, payload)) {
                    Serial.print("Secure Publish Successful: ");
                    Serial.println(payload);
                    
                    // Only update memory if the publish succeeded
                    lastPublishedDistance = currentDistance;
                } else {
                    Serial.println("Secure Publish Failed!");
                }
                delay(500); // Allow packet to transmit
            }
            
            // Clean disconnect
            client.disconnect();
            WiFi.disconnect(true);
            WiFi.mode(WIFI_OFF);
            
        } else {
            Serial.println("No meaningful distance change. Bypassing Wi-Fi to save battery.");
        }
    }

    // ==========================================
    // 6. PREPARE FOR DEEP SLEEP
    // ==========================================
    // Shut down the UART connection cleanly
    HMMDSerial.end();

    // Set timer to wake up again
    uint64_t sleepTime_us = WAKEUP_INTERVAL_SEC * 1000000ULL; 
    esp_sleep_enable_timer_wakeup(sleepTime_us);
    
    Serial.println("Going to Deep Sleep now... Zzz...");
    delay(100); 
    esp_deep_sleep_start();
}

