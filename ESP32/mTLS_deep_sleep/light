// ==========================================
// 4. HELPER FUNCTIONS
// ==========================================
void syncTime() {
  // Only sync if the RTC lost track of time (saves battery on wakeups)
  time_t now = time(nullptr);
  if (now < 1672531200) { 
    configTime(0, 0, "pool.ntp.org", "time.google.com");
    Serial.print("Syncing Clock for TLS (First boot only): ");
    while (now < 1672531200) { 
      delay(500);
      Serial.print(".");
      now = time(nullptr);
    }
    Serial.println("\n[OK] Time Synced.");
  }
}

void setup_wifi() {
  Serial.print("Connecting to WiFi...");
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) { 
    delay(500); 
    Serial.print(".");
  }
  Serial.println("\nWiFi connected.");
}

void connect_mqtt() {
  Serial.print("Attempting STRICT mTLS connection...");
  if (client.connect(mqtt_client_id)) {
    Serial.println("CONNECTED SECURELY!");
  } else {
    Serial.print("failed, rc=");
    Serial.print(client.state());
    Serial.println(" - Retrying in 5s...");
    delay(5000); 
  }
}

// ==========================================
// 5. MAIN LOGIC (Runs once per wakeup)
// ==========================================
void setup() {
  Serial.begin(115200);
  analogSetAttenuation(ADC_11db); 
  bootCount++;

  // 1. Take a rapid analog reading immediately upon waking up
  int currentRead = analogRead(lightSensorPin);
  Serial.print(">>> WOKE UP. Light Sensor ADC Value: ");
  Serial.println(currentRead);

  // 2. Evaluate current state using your existing Hysteresis logic
  bool newState = isDaytime; // Assume no change initially

  if (!isDaytime && (currentRead > (threshold + hysteresis))) {
    newState = true; // Became Day
  } 
  else if (isDaytime && (currentRead < (threshold - hysteresis))) {
    newState = false; // Became Night
  }

  // 3. Core Battery Logic: Did the state change, or is this the first boot?
  if (newState != isDaytime || firstRun) {
    Serial.println("*** STATE CHANGE OR FIRST BOOT! Booting Network Stack ***");
    
    // Boot the power-hungry Wi-Fi
    setup_wifi();
    syncTime();

    espClient.setCACert(root_ca); 
    espClient.setCertificate(client_cert); 
    espClient.setPrivateKey(client_key);   
    espClient.setHandshakeTimeout(45); 

    client.setServer(mqtt_server, 8883);
    connect_mqtt();

    if (client.connected()) {
      String payload = newState ? "Day" : "Night";
      
      Serial.print("Secure Transition to: ");
      Serial.println(payload);
      
      if(client.publish(mqtt_publish_topic, payload.c_str())) {
         // Successfully published; update RTC memory
         isDaytime = newState;
         firstRun = false; 
      } else {
         Serial.println("Secure Publish Failed!");
      }
      delay(500); // Allow packet to fully transmit before cutting Wi-Fi
    }
    
    // Clean disconnect
    client.disconnect();
    WiFi.disconnect(true);
    WiFi.mode(WIFI_OFF);
    
  } else {
    // If the light level is still within the hysteresis band, skip Wi-Fi entirely!
    Serial.println("No state change. Bypassing Wi-Fi to save battery.");
  }

  // ==========================================
  // 6. PREPARE FOR DEEP SLEEP
  // ==========================================
  
  // Set the internal hardware timer to wake us up again in 10 seconds
  uint64_t sleepTime_us = WAKEUP_INTERVAL_SEC * 1000000ULL; 
  esp_sleep_enable_timer_wakeup(sleepTime_us);
  
  Serial.println("Going to Deep Sleep now... Zzz...");
  delay(100); 
  esp_deep_sleep_start();
}

// ==========================================
// 7. LOOP (Obsolete in Deep Sleep Architecture)
// ==========================================
void loop() {
  // Never reached. CPU shuts down at the end of setup().
}
