// ==========================================
// 4. HELPER FUNCTIONS
// ==========================================
void setup_wifi() {
  Serial.print("Connecting to WiFi...");
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) { 
    delay(500); 
    Serial.print(".");
  }
  Serial.println("\nWiFi connected.");
}

void syncTime() {
  // Only sync if the RTC has lost track of time (saves battery)
  time_t now = time(nullptr);
  if (now < 1672531200) { 
    configTime(0, 0, "pool.ntp.org", "time.google.com");
    Serial.print("Syncing Clock for TLS (First boot only): ");
    while (now < 1672531200) { 
      delay(500);
      Serial.print(".");
      now = time(nullptr);
    }
    Serial.println("\n[OK] Time Synced.");
  }
}

void connect_mqtt() {
  Serial.print("Attempting STRICT mTLS connection...");
  if (client.connect(mqtt_client_id)) {
    Serial.println("CONNECTED SECURELY!");
  } else {
    Serial.print("failed, rc=");
    Serial.print(client.state());
    Serial.println(" - Retrying in 5s...");
    delay(5000); 
  }
}

// ==========================================
// 5. MAIN LOGIC (Runs once per wakeup)
// ==========================================
void setup() {
  Serial.begin(115200);
  analogSetAttenuation(ADC_11db);
  bootCount++;
  
  // 1. Take a rapid analog reading immediately
  int val = analogRead(waterSensorPin);
  Serial.print(">>> WOKE UP. Water Sensor ADC Value: ");
  Serial.println(val);

  // 2. Determine the current state based on your hysteresis logic
  WaterState newState = lastState; // Default to assuming no change

  if (val < threshold_Flood) {
    newState = FLOOD_ALERT;
  } 
  else if (val < threshold_WaterPresent && val >= (threshold_Flood + hysteresis)) {
    newState = WATER_PRESENT;
  } 
  else if (val >= (threshold_WaterPresent + hysteresis)) {
    newState = DRY;
  }

  // 3. Core Battery Logic: Did the state change?
  if (newState != lastState) {
    Serial.println("*** STATE CHANGE DETECTED! Booting Network Stack ***");
    
    // Boot the power-hungry Wi-Fi only because something changed
    setup_wifi();
    syncTime();

    espClient.setCACert(root_ca); 
    espClient.setCertificate(client_cert); 
    espClient.setPrivateKey(client_key);   
    espClient.setHandshakeTimeout(45); 

    client.setServer(mqtt_server, 8883);
    connect_mqtt();

    if (client.connected()) {
      String message;
      if (newState == DRY)           message = "Dry";
      if (newState == WATER_PRESENT) message = "Water Detected";
      if (newState == FLOOD_ALERT)   message = "FLOOD ALERT";

      Serial.print("Secure Transition to: ");
      Serial.println(message);
      
      client.publish(mqtt_publish_topic, message.c_str());
      delay(500); // Allow packet to transmit before pulling the plug
    }
    
    // Update memory for the next wakeup
    lastState = newState;
    
    // Clean disconnect
    client.disconnect();
    WiFi.disconnect(true);
    WiFi.mode(WIFI_OFF);
    
  } else {
    // If the state is exactly the same as 5 seconds ago, skip Wi-Fi entirely!
    Serial.println("No change in water state. Bypassing Wi-Fi to save battery.");
  }

  // ==========================================
  // 6. PREPARE FOR DEEP SLEEP
  // ==========================================
  
  // Set the internal hardware timer to wake us up again in 5 seconds
  uint64_t sleepTime_us = WAKEUP_INTERVAL_SEC * 1000000ULL; 
  esp_sleep_enable_timer_wakeup(sleepTime_us);
  
  Serial.println("Going to Deep Sleep now... Zzz...");
  delay(100); 
  esp_deep_sleep_start();
}

