// ==========================================
// 4. HELPER FUNCTIONS
// ==========================================
void setup_wifi() {
    Serial.print("Connecting to WiFi ");
    WiFi.begin(ssid, password);
    while (WiFi.status() != WL_CONNECTED) {
        delay(500);
        Serial.print(".");
    }
    Serial.println(" [CONNECTED]");
}

void syncTime() {
    time_t now = time(nullptr);
    if (now < 1672531200) { 
        configTime(0, 0, "pool.ntp.org", "time.google.com");
        Serial.print("Syncing Clock for TLS... ");
        while (now < 1672531200) { 
            delay(500);
            Serial.print(".");
            now = time(nullptr);
        }
        Serial.println(" [OK]");
    }
}

void connect_mqtt() {
    Serial.print("Attempting mTLS connection...");
    if (client.connect(mqtt_client_id)) {
        Serial.println(" [SECURELY CONNECTED]");
    } else {
        Serial.print(" [FAILED, rc=");
        Serial.print(client.state());
        Serial.println("]");
    }
}

// ==========================================
// 5. SETUP (Runs only once on physical power-up)
// ==========================================
void setup() {
    Serial.begin(115200); 
    pinMode(PIR_PIN, INPUT); 
    
    Serial.println(">>> NORMAL BOOT (Power On) <<<");
    currentRoomState = OUT; 

    // Configure Pin 23 to wake the ESP32 from Light Sleep when it goes HIGH
    gpio_wakeup_enable((gpio_num_t)PIR_PIN, GPIO_INTR_HIGH_LEVEL);
    esp_sleep_enable_gpio_wakeup();
}

// ==========================================
// 6. LOOP (Executes upon Wakeup, then Sleeps)
// ==========================================
void loop() {
    // 1. Check if the PIR is currently triggered
    if (digitalRead(PIR_PIN) == HIGH) {
        Serial.println(">>> WOKE UP FROM LIGHT SLEEP (MOTION DETECTED) <<<");
        bootCount++;
        
        // Toggle the room state logic
        if (currentRoomState == OUT) {
            currentRoomState = IN;
            Serial.println("State Change: IN");
        } else {
            currentRoomState = OUT;
            Serial.println("State Change: OUT");
        }

        // 2. Connect to Network and Publish
        setup_wifi();
        syncTime();

        espClient.setCACert(root_ca); 
        espClient.setCertificate(client_cert); 
        espClient.setPrivateKey(client_key);   
        espClient.setHandshakeTimeout(45); 

        client.setServer(mqtt_server, 8883);
        connect_mqtt();

        if (client.connected()) {
            if (currentRoomState == IN) {
                client.publish(mqtt_publish_topic, "IN");
            } else {
                client.publish(mqtt_publish_topic, "OUT");
            }
            Serial.println("Payload sent over mTLS.");
            delay(500); // Ensure packet transmits before cutting Wi-Fi
        }
    }

    // 3. Prepare for Light Sleep
    client.disconnect();
    WiFi.disconnect(true);
    WiFi.mode(WIFI_OFF);
    
    // Wait for the Pi Hut Mini PIR to finish its 2-second HIGH latch
    Serial.print("Waiting for PIR latch to settle (Go LOW)...");
    while(digitalRead(PIR_PIN) == HIGH) {
        delay(100);
        Serial.print(".");
    }
    Serial.println(" [SETTLED]");

    Serial.println("Entering Light Sleep mode to preserve PCB Pin 23... Zzz...");
    delay(100); 
    
    // 4. Sleep until Pin 23 goes HIGH again. 
    // The code execution pauses right here on this line, and resumes at the top of the loop() when woken.
    esp_light_sleep_start();
}
